# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# Gemini API key (server only)
GEMINI_API_KEY=

# MongoDB Atlas connection string (server only)
MONGODB_URI=

# Solana volunteer-hour audit receipts (server only)
# Set to false to explicitly disable publishing. When no authority is supplied,
# verified exchanges remain valid and are shown as awaiting network setup.
SOLANA_AUDIT_ENABLED=true
SOLANA_NETWORK=devnet
# Optional for devnet/testnet/mainnet-beta; required for a custom network.
SOLANA_RPC_URL=
# Dedicated, low-balance authority key as a 64-byte JSON array or base64 string.
# Never expose this value through a VITE_ variable.
SOLANA_AUTHORITY_SECRET_KEY=
